# Copy this file to backend.tf and replace the bucket with your own bootstrap bucket.
# The S3 bucket must exist before running terraform init.
terraform {
  backend "s3" {
    bucket       = "REPLACE-WITH-YOUR-TERRAFORM-STATE-BUCKET"
    key          = "terraform.tfstate"
    region       = "eu-north-1"
    profile      = "terraform-lab"
    encrypt      = true
    use_lockfile = true
  }
}
